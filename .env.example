# Which WhatsApp connection engine to use:
#   webjs   - drives a real headless Chromium browser (whatsapp-web.js). Best
#             for a computer, server, or Docker host. Needs a working Chromium.
#   baileys - talks to WhatsApp directly over a WebSocket, no browser needed.
#             Best for constrained environments like Termux on a phone.
ENGINE=webjs

# Only used when ENGINE=baileys and you want to log in by typing a code into
# WhatsApp instead of scanning a QR (handy when the bot runs on the same
# phone you'd otherwise need a second screen to scan with). International
# format, digits only, no "+" — e.g. 15551234567
PAIRING_PHONE_NUMBER=

# Command prefix for bot commands (e.g. !help, !kick)
PREFIX=!

# Comma-separated WhatsApp IDs that can use admin commands in DMs / groups
# even if they aren't a WhatsApp group admin. Group admins are always
# allowed regardless of this list. ID format depends on ENGINE:
#   webjs:   15551234567@c.us
#   baileys: 15551234567@s.whatsapp.net
BOT_ADMINS=

# Default state for the anti-malicious-link filter in new groups (true/false)
ANTILINK_DEFAULT=true

# Default state for the bad-language filter in new groups (true/false)
FILTER_DEFAULT=true

# Warnings before an offending user is auto-kicked from a group (bot must be a group admin)
MAX_WARNINGS=3

# Optional: Google Safe Browsing API key for real-time malicious URL lookups.
# https://developers.google.com/safe-browsing/v4/get-started
# If left blank, the bot falls back to its local blocklist + heuristics only.
GOOGLE_SAFE_BROWSING_API_KEY=

# Where the authenticated session is stored (mount as a volume in Docker).
# Each engine keeps its own subfolder here, so it's safe to share one path.
SESSION_PATH=.wa_auth
